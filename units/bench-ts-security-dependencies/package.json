{
  "name": "depot-dispatch",
  "version": "1.4.0",
  "description": "Dispatch runs, delivery windows and printer-ready labels for a courier's parcel depots.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "3.4.2",
    "axios": "0.21.1",
    "date-fns": "1.30.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "8.5.1",
    "jszip": "3.10.2",
    "lodash": "4.18.1",
    "mupdf": "1.28.1",
    "nock": "15.0.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "string-similarity": "4.0.4",
    "tweetnacl": "1.0.3",
    "uuid": "14.0.2",
    "xml2js": "0.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "8.5.9",
    "@types/lodash": "4.17.25",
    "@types/ms": "2.1.0",
    "@types/node": "22.20.5",
    "@types/string-similarity": "4.0.2",
    "@types/supertest": "7.2.1",
    "@types/tmp": "0.2.6",
    "@types/xml2js": "0.4.14",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tmp": "0.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "jws": "3.2.3"
  }
}
