+    int MaxAppointmentsPerDay)
 {
     public TimeZoneInfo? Zone => TimeZone is not null && TimeZoneInfo.TryFindSystemTimeZoneById(TimeZone, out var zone) ? zone : null;
 
@@ -15,5 +16,6 @@ public sealed record ScheduleRequest(
         new RequestErrors()
