new file mode 100644
index 0000000..512ef0d
--- /dev/null
+++ b/src/ClinicScheduling.Waitlist/WaitlistStore.cs
@@ -0,0 +1,25 @@
+using System.Collections.Concurrent;
+
+namespace ClinicScheduling.Waitlist;
+
+/// <summary>Process-memory waitlist, in the order patients joined it.</summary>
+public sealed class WaitlistStore
+{
+    private readonly ConcurrentDictionary<Guid, WaitlistEntry> _entries = new();
+    private readonly ConcurrentQueue<WaitlistOffer> _offers = new();
+
+    public IReadOnlyList<WaitlistOffer> Offers => [.. _offers];
+
+    public void Join(WaitlistEntry entry)
+    {
+        ArgumentNullException.ThrowIfNull(entry);
+        _entries[entry.Id] = entry;
+    }
+
+    public IReadOnlyList<WaitlistEntry> For(Guid practitionerId) =>
+        [.. _entries.Values.Where(e => e.PractitionerId == practitionerId).OrderBy(e => e.JoinedAt)];
+
+    public void Remove(Guid entryId) => _entries.TryRemove(entryId, out _);
+
+    public void Offer(WaitlistOffer offer) => _offers.Enqueue(offer);
+}
