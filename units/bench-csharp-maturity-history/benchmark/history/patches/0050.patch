@@ -0,0 +1,47 @@
+using ClinicScheduling.Domain.Appointments;
+using ClinicScheduling.Domain.Availability;
+using ClinicScheduling.Waitlist;
+using static ClinicScheduling.UnitTests.TestData;
+
+namespace ClinicScheduling.UnitTests.Waitlist;
+
+public sealed class WaitlistBackfillTests
+{
+    private readonly WaitlistStore _store = new();
+
+    private static Appointment Cancelled(int day)
+    {
+        var appointment = Appointment.Book(Guid.NewGuid(), PractitionerId, Guid.NewGuid(), new TimeRange(At(Monday.AddDays(day), 9), At(Monday.AddDays(day), 10)));
+        appointment.Cancel(CancellationReason.PatientRequest, Now);
+        return appointment;
+    }
+
+    private WaitlistEntry Join(int earliest, int latest, int minutesAgo)
+    {
+        var entry = new WaitlistEntry(Guid.NewGuid(), Guid.NewGuid(), PractitionerId, Monday.AddDays(earliest), Monday.AddDays(latest), Now.AddMinutes(-minutesAgo));
+        _store.Join(entry);
+        return entry;
+    }
+
+    [Fact]
+    public void OffersTheSlotToTheFirstMatchingPatient()
+    {
+        Join(5, 9, minutesAgo: 30);
+        var first = Join(1, 4, minutesAgo: 20);
+        Join(1, 4, minutesAgo: 10);
+
+        var offer = new WaitlistBackfill(_store, new FixedClock(Now)).OfferFreedSlot(Cancelled(2));
+
+        Assert.NotNull(offer);
+        Assert.Equal(first.PatientId, offer.PatientId);
+        Assert.DoesNotContain(_store.For(PractitionerId), e => e.Id == first.Id);
+    }
+
+    [Fact]
+    public void OffersNothingWhenNobodyFits()
+    {
+        Join(5, 9, minutesAgo: 30);
+
+        Assert.Null(new WaitlistBackfill(_store, new FixedClock(Now)).OfferFreedSlot(Cancelled(2)));
+    }
+}
