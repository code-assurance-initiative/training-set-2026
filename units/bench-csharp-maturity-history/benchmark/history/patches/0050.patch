@@ -0,0 +1,10 @@
+namespace ClinicScheduling.Waitlist;
+
+/// <summary>A patient waiting for an earlier appointment with a practitioner, on any day in [Earliest, Latest].</summary>
+public sealed record WaitlistEntry(Guid Id, Guid PatientId, Guid PractitionerId, DateOnly Earliest, DateOnly Latest, DateTimeOffset JoinedAt)
+{
+    public bool Accepts(DateOnly day) => day >= Earliest && day <= Latest;
+}
+
+/// <summary>A freed slot offered to a waiting patient.</summary>
+public sealed record WaitlistOffer(Guid EntryId, Guid PatientId, DateTimeOffset SlotStart, DateTimeOffset SlotEnd);
