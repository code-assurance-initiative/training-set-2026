@@ -0,0 +1,7 @@
+namespace ClinicScheduling.Domain.Time;
+
+/// <summary>The current time, injected so that time-dependent rules can be tested (ADR 0003).</summary>
+public interface IClock
+{
+    DateTimeOffset UtcNow { get; }
+}
