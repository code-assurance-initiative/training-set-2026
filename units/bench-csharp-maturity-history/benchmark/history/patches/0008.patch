+++ b/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
@@ -6,8 +6,9 @@ namespace ClinicScheduling.UnitTests.Availability;
 public sealed class SlotFinderTests
 {
     private static readonly TimeSpan HalfHour = TimeSpan.FromMinutes(30);
+    private readonly FixedClock _clock = new(Now);
 
-    private static SlotFinder Finder(params DateOnly[] holidays) => new(new FixedHolidays(holidays));
+    private SlotFinder Finder(params DateOnly[] holidays) => new(new FixedHolidays(holidays), _clock);
 
     private static SlotQuery Tuesday(TimeSpan? duration = null) =>
         new(Monday.AddDays(1), Monday.AddDays(1), duration ?? HalfHour);
@@ -41,4 +42,14 @@ public sealed class SlotFinderTests
         Assert.DoesNotContain(slots, s => s.Start > At(tuesday, 8, 30) && s.Start < At(tuesday, 10));
         Assert.Contains(slots, s => s.Start == At(tuesday, 10));
     }
+
+    [Fact]
+    public void RespectsMinimumNotice()
+    {
+        var today = new SlotQuery(Monday, Monday, HalfHour);
+
+        var morning = Finder().FindOpenSlots(Schedule(), [], today, new SlotSearchOptions());
+
+        Assert.All(morning, s => Assert.True(s.Start >= Now + TimeSpan.FromHours(2)));
+    }
 }
