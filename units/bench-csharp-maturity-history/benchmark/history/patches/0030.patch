         Assert.Equal(slots[0].Start, appointment.Start);
         Assert.Equal(new CancellationDto(0m, false, "free"), await cancelled.ReadAsync<CancellationDto>());
         Assert.Equal("cancelled", fetched.Status);
+        Assert.Equal("PatientRequest", fetched.CancellationReason);
     }
 
     [Fact]
diff --git a/tests/ClinicScheduling.IntegrationTests/Responses.cs b/tests/ClinicScheduling.IntegrationTests/Responses.cs
