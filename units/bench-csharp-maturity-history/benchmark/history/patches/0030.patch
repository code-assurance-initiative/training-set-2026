Subject: feat(api): cancellation details in appointment responses

---
 src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs | 8 ++++++--
 .../ClinicScheduling.IntegrationTests/BookingFlowTests.cs | 1 +
 tests/ClinicScheduling.IntegrationTests/Responses.cs      | 2 +-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs b/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs
index 3c29791..8031a8e 100644
--- a/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs
+++ b/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs
@@ -11,7 +11,9 @@ public sealed record AppointmentResponse(
     DateTimeOffset Start,
     DateTimeOffset End,
     string Status,
-    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] Guid? SeriesId)
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] Guid? SeriesId,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] string? CancellationReason,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] DateTimeOffset? CancelledAt)
 {
     public static AppointmentResponse From(Appointment appointment)
     {
@@ -24,6 +26,8 @@ public sealed record AppointmentResponse(
             appointment.Time.Start,
             appointment.Time.End,
             appointment.Status.ToString().ToLowerInvariant(),
-            appointment.SeriesId);
+            appointment.SeriesId,
+            appointment.CancellationReason?.ToString(),
+            appointment.CancelledAt);
     }
 }
diff --git a/tests/ClinicScheduling.IntegrationTests/BookingFlowTests.cs b/tests/ClinicScheduling.IntegrationTests/BookingFlowTests.cs
