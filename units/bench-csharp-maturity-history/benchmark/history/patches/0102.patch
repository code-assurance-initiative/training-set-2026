diff --git a/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs b/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs
index ed80e75..3bc2128 100644
--- a/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs
+++ b/src/ClinicScheduling.Api/Contracts/AppointmentResponse.cs
@@ -40,7 +40,7 @@ public sealed record AppointmentResponse(
     }
 
     private static string Timestamp(DateTimeOffset instant) =>
-        instant.ToString("O", CultureInfo.InvariantCulture);
+        instant.ToString("yyyy-MM-dd'T'HH:mm:sszzz", CultureInfo.InvariantCulture);
 
     private static string StatusCode(AppointmentStatus status) => status switch
     {
diff --git a/src/ClinicScheduling.Infrastructure/PatientPortal/PortalAppointmentFeed.cs b/src/ClinicScheduling.Infrastructure/PatientPortal/PortalAppointmentFeed.cs
