From 0846dd8cd512bc0754cd6c691708a3fa614692cb Mon Sep 17 00:00:00 2001
From: Lena Marsh <lena.marsh@example.invalid>
Date: Wed, 23 Sep 2026 10:15:14 +0200
Subject: fix(availability): reject queries without a duration

---
 src/ClinicScheduling.Domain/Availability/SlotFinder.cs          | 2 +-
 .../ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs  | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/ClinicScheduling.Domain/Availability/SlotFinder.cs b/src/ClinicScheduling.Domain/Availability/SlotFinder.cs
index 49e6ebd..997cc28 100644
--- a/src/ClinicScheduling.Domain/Availability/SlotFinder.cs
+++ b/src/ClinicScheduling.Domain/Availability/SlotFinder.cs
@@ -19,7 +19,7 @@ public sealed class SlotFinder(IHolidayCalendar holidays, TimeProvider time)
         ArgumentNullException.ThrowIfNull(query);
         ArgumentNullException.ThrowIfNull(options);
 
-        if (query.To < query.From)
+        if (query.Duration <= TimeSpan.Zero || query.To < query.From)
         {
             return [];
         }
diff --git a/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs b/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
index 567bba8..40d7885 100644
--- a/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
+++ b/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
@@ -114,5 +114,6 @@ public sealed class SlotFinderTests
     public void RejectsEmptyQueries()
     {
         Assert.Empty(Finder().FindOpenSlots(Schedule(), [], new SlotQuery(Monday.AddDays(2), Monday.AddDays(1), HalfHour), new SlotSearchOptions()));
+        Assert.Empty(Finder().FindOpenSlots(Schedule(), [], Tuesday(TimeSpan.Zero), new SlotSearchOptions()));
     }
 }
