diff --git a/src/ClinicScheduling.Application/Reminders/ReminderOptions.cs b/src/ClinicScheduling.Application/Reminders/ReminderOptions.cs
index 60fc3ac..4dc89ad 100644
--- a/src/ClinicScheduling.Application/Reminders/ReminderOptions.cs
+++ b/src/ClinicScheduling.Application/Reminders/ReminderOptions.cs
@@ -7,4 +7,9 @@ public sealed record ReminderOptions
     public TimeSpan DayBeforeLead { get; init; } = TimeSpan.FromHours(48);
 
     public TimeSpan SameDayLead { get; init; } = TimeSpan.FromHours(2);
+
+    /// <summary>No reminder is sent between these local times; one that would be is sent at the start of the evening instead.</summary>
+    public TimeOnly QuietHoursStart { get; init; } = new(21, 0);
+
+    public TimeOnly QuietHoursEnd { get; init; } = new(8, 0);
 }
diff --git a/src/ClinicScheduling.Application/Reminders/ReminderPlanner.cs b/src/ClinicScheduling.Application/Reminders/ReminderPlanner.cs
index 73f6201..d2772e4 100644
--- a/src/ClinicScheduling.Application/Reminders/ReminderPlanner.cs
+++ b/src/ClinicScheduling.Application/Reminders/ReminderPlanner.cs
@@ -17,7 +17,7 @@ public sealed class ReminderPlanner(IOptions<ReminderOptions> options, IClock cl
         var plan = new List<PlannedReminder>(2);
         foreach (var (kind, lead) in new[] { (ReminderKind.DayBefore, settings.DayBeforeLead), (ReminderKind.SameDay, settings.SameDayLead) })
         {
-            var sendAt = appointment.Time.Start - lead;
+            var sendAt = OutsideQuietHours(appointment.Time.Start - lead, zone, settings);
             if (sendAt > now && sendAt < appointment.Time.Start)
             {
                 plan.Add(new PlannedReminder(Guid.NewGuid(), appointment.Id, appointment.PatientId, sendAt, kind));
@@ -26,4 +26,18 @@ public sealed class ReminderPlanner(IOptions<ReminderOptions> options, IClock cl
 
         return plan;
     }
+
+    private static DateTimeOffset OutsideQuietHours(DateTimeOffset instant, TimeZoneInfo zone, ReminderOptions settings)
+    {
+        var local = TimeZoneInfo.ConvertTime(instant, zone);
+        var clock = TimeOnly.FromDateTime(local.DateTime);
+        if (!clock.IsBetween(settings.QuietHoursStart, settings.QuietHoursEnd))
+        {
+            return instant;
+        }
+
+        var eveningDay = clock >= settings.QuietHoursStart ? local.Date : local.Date.AddDays(-1);
+        var evening = eveningDay + settings.QuietHoursStart.ToTimeSpan() - TimeSpan.FromMinutes(30);
+        return new DateTimeOffset(evening, zone.GetUtcOffset(evening));
+    }
 }
