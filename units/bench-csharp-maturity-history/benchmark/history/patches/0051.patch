diff --git a/src/ClinicScheduling.Api/Endpoints/WaitlistEndpoints.cs b/src/ClinicScheduling.Api/Endpoints/WaitlistEndpoints.cs
new file mode 100644
index 0000000..56ea100
--- /dev/null
+++ b/src/ClinicScheduling.Api/Endpoints/WaitlistEndpoints.cs
@@ -0,0 +1,32 @@
+using ClinicScheduling.Api.Contracts;
+using ClinicScheduling.Api.Security;
+using ClinicScheduling.Domain.Time;
+using ClinicScheduling.Waitlist;
+
+namespace ClinicScheduling.Api.Endpoints;
+
+public static class WaitlistEndpoints
+{
+    public static IEndpointRouteBuilder MapWaitlistEndpoints(this IEndpointRouteBuilder app)
+    {
+        var group = app.MapGroup("/api/waitlist").WithTags("Waitlist");
+        group.MapPost("/", Join).RequireAuthorization(AuthorizationPolicies.AppointmentsWrite);
+        group.MapGet("/{practitionerId:guid}", List).RequireAuthorization(AuthorizationPolicies.AppointmentsRead);
+        return app;
+    }
+
+    private static IResult Join(JoinWaitlistRequest request, WaitlistStore store, IClock clock)
+    {
+        var errors = request.Validate();
+        if (errors.Any)
+        {
+            return Results.ValidationProblem(errors.ToDictionary());
+        }
+
+        var entry = new WaitlistEntry(Guid.NewGuid(), request.PatientId, request.PractitionerId, request.Earliest, request.Latest, clock.UtcNow);
+        store.Join(entry);
+        return Results.Ok(entry);
+    }
+
+    private static IResult List(Guid practitionerId, WaitlistStore store) => Results.Ok(store.For(practitionerId));
+}
