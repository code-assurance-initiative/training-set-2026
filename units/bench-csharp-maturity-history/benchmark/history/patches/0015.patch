diff --git a/tests/ClinicScheduling.IntegrationTests/SchedulingApiFactory.cs b/tests/ClinicScheduling.IntegrationTests/SchedulingApiFactory.cs
new file mode 100644
index 0000000..68db0ff
--- /dev/null
+++ b/tests/ClinicScheduling.IntegrationTests/SchedulingApiFactory.cs
@@ -0,0 +1,71 @@
+using ClinicScheduling.Domain.Time;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.AspNetCore.TestHost;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.IdentityModel.Protocols;
+using Microsoft.IdentityModel.Protocols.OpenIdConnect;
+
+namespace ClinicScheduling.IntegrationTests;
+
+/// <summary>
+/// Hosts the real API in memory. Only two things are replaced: the clock (so expiry is deterministic) and the
+/// issuer metadata (so tokens from <see cref="TestTokens"/> validate without a network call).
+/// </summary>
+public sealed class SchedulingApiFactory : WebApplicationFactory<Program>
+{
+    public TestClock Clock { get; } = new(new DateTimeOffset(2026, 3, 2, 8, 0, 0, TimeSpan.Zero));
+
+    public TestTokens Tokens { get; } = new();
+
+    /// <summary>A client over HTTPS (so HSTS and redirection behave as in production) with the given scopes.</summary>
+    public HttpClient CreateClient(params string[] scopes)
+    {
+        var client = CreateClient(new WebApplicationFactoryClientOptions { BaseAddress = new Uri("https://scheduling.test") });
+        if (scopes.Length > 0)
+        {
+            client.DefaultRequestHeaders.Authorization = new("Bearer", Tokens.Create(scopes));
+        }
+
+        return client;
+    }
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+        builder.UseSetting("Authentication:Authority", TestTokens.Issuer);
+        builder.UseSetting("Authentication:Audience", TestTokens.Audience);
+        builder.UseSetting("https_port", "443");
+        builder.ConfigureTestServices(services =>
+        {
+            services.RemoveAll<IClock>();
+            services.AddSingleton<IClock>(Clock);
+            services.PostConfigure<JwtBearerOptions>(JwtBearerDefaults.AuthenticationScheme, options =>
+            {
+                var metadata = Tokens.Metadata();
+                options.Configuration = metadata;
+                options.ConfigurationManager = new StaticConfigurationManager<OpenIdConnectConfiguration>(metadata);
+            });
+        });
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing)
+        {
+            Tokens.Dispose();
+        }
+
+        base.Dispose(disposing);
+    }
+}
+
+/// <summary>The test host's clock: it stands still until a test moves it.</summary>
+public sealed class TestClock(DateTimeOffset now) : IClock
+{
+    public DateTimeOffset UtcNow { get; private set; } = now;
+
+    public void SetUtcNow(DateTimeOffset value) => UtcNow = value;
+}
diff --git a/tests/ClinicScheduling.IntegrationTests/TestTokens.cs b/tests/ClinicScheduling.IntegrationTests/TestTokens.cs
