-using ClinicScheduling.Domain.Appointments;
-
-namespace ClinicScheduling.Waitlist;
-
-/// <summary>
-/// Offers the slot of a cancelled appointment to the first patient on the practitioner's waitlist whose window
-/// contains the day.
-/// </summary>
-public sealed class WaitlistBackfill(WaitlistStore store, TimeProvider time)
-{
-    /// <summary>How long an offer is held for one patient before the slot is offered to the next.</summary>
-    public static readonly TimeSpan OfferHold = TimeSpan.FromMinutes(30);
-
-    public WaitlistOffer? OfferFreedSlot(Appointment cancelled)
-    {
-        ArgumentNullException.ThrowIfNull(cancelled);
-        var day = DateOnly.FromDateTime(cancelled.Time.Start.UtcDateTime);
-        var next = store.For(cancelled.PractitionerId).FirstOrDefault(e => e.Accepts(day) && e.PatientId != cancelled.PatientId);
-        if (next is null || cancelled.Time.Start <= time.GetUtcNow())
-        {
-            return null;
-        }
-
-        var offer = new WaitlistOffer(next.Id, next.PatientId, cancelled.Time.Start, cancelled.Time.End, time.GetUtcNow() + OfferHold);
-        store.Offer(offer);
-        store.Remove(next.Id);
-        return offer;
-    }
-}
