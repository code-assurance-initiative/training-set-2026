-
-    private static Appointment Cancelled(int day)
-    {
-        var appointment = Appointment.Book(Guid.NewGuid(), PractitionerId, Guid.NewGuid(), new TimeRange(At(Monday.AddDays(day), 9), At(Monday.AddDays(day), 10)), false);
