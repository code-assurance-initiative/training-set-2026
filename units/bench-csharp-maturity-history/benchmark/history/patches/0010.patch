diff --git a/src/ClinicScheduling.Infrastructure/Holidays/TableHolidayCalendar.cs b/src/ClinicScheduling.Infrastructure/Holidays/TableHolidayCalendar.cs
new file mode 100644
index 0000000..515f194
--- /dev/null
+++ b/src/ClinicScheduling.Infrastructure/Holidays/TableHolidayCalendar.cs
@@ -0,0 +1,19 @@
+using System.Collections.Frozen;
+using ClinicScheduling.Domain.Holidays;
+
+namespace ClinicScheduling.Infrastructure.Holidays;
+
+internal readonly record struct PublicHoliday(DateOnly Date, string CountryCode, string Name);
+
+/// <summary>The holiday calendar backed by the generated <see cref="PublicHolidays"/> table.</summary>
+public sealed class TableHolidayCalendar : IHolidayCalendar
+{
+    private static readonly FrozenSet<(string CountryCode, DateOnly Date)> Days =
+        PublicHolidays.All.Select(h => (h.CountryCode, h.Date)).ToFrozenSet();
+
+    public bool IsHoliday(string countryCode, DateOnly day)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(countryCode);
+        return Days.Contains((countryCode.ToUpperInvariant(), day));
+    }
+}
diff --git a/tests/ClinicScheduling.UnitTests/Holidays/TableHolidayCalendarTests.cs b/tests/ClinicScheduling.UnitTests/Holidays/TableHolidayCalendarTests.cs
new file mode 100644
index 0000000..a385e7e
--- /dev/null
+++ b/tests/ClinicScheduling.UnitTests/Holidays/TableHolidayCalendarTests.cs
@@ -0,0 +1,26 @@
+using ClinicScheduling.Infrastructure.Holidays;
+
+namespace ClinicScheduling.UnitTests.Holidays;
+
+public sealed class TableHolidayCalendarTests
+{
+    private readonly TableHolidayCalendar _calendar = new();
+
+    [Theory]
+    [InlineData("DK", 2026, 4, 2)]
+    [InlineData("dk", 2026, 12, 24)]
+    [InlineData("DE", 2026, 10, 3)]
+    public void KnowsTheTabledHolidays(string country, int year, int month, int day)
+    {
+        Assert.True(_calendar.IsHoliday(country, new DateOnly(year, month, day)));
+    }
+
+    [Theory]
+    [InlineData("DK", 2026, 3, 2)]
+    [InlineData("DE", 2026, 6, 5)]
+    [InlineData("FR", 2026, 1, 1)]
+    public void TreatsEverythingElseAsAWorkingDay(string country, int year, int month, int day)
+    {
+        Assert.False(_calendar.IsHoliday(country, new DateOnly(year, month, day)));
+    }
+}
diff --git a/tools/holidays/generate-holidays.sh b/tools/holidays/generate-holidays.sh
new file mode 100755
index 0000000..0bc1c5c
--- /dev/null
+++ b/tools/holidays/generate-holidays.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Regenerates src/ClinicScheduling.Infrastructure/Holidays/PublicHolidays.g.cs from holidays.csv.
+# Usage (from the repository root): tools/holidays/generate-holidays.sh
+set -euo pipefail
+
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+csv="$here/holidays.csv"
+out="$here/../../src/ClinicScheduling.Infrastructure/Holidays/PublicHolidays.g.cs"
+
+{
+  cat <<'HEADER'
+// <auto-generated>
+//     This file was generated by tools/holidays/generate-holidays.sh from tools/holidays/holidays.csv.
+//     Do not edit it by hand: change the CSV and run the script again.
+// </auto-generated>
+
+namespace ClinicScheduling.Infrastructure.Holidays;
+
+internal static class PublicHolidays
+{
+    public static readonly PublicHoliday[] All =
+    [
+HEADER
+  tail -n +2 "$csv" | LC_ALL=C sort -t, -k2,2 -k1,1 | awk -F, '{
+    split($1, d, "-")
+    printf "        new(new DateOnly(%d, %d, %d), \"%s\", \"%s\"),\n", d[1], d[2], d[3], $2, $3
+  }'
+  cat <<'FOOTER'
+    ];
+}
+FOOTER
+} > "$out"
