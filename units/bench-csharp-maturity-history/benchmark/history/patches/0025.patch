+using ClinicScheduling.Domain.Appointments;
+
+namespace ClinicScheduling.Domain.Policies;
+
+/// <summary>The clinic's cancellation rules: who pays a fee for cancelling, and how much.</summary>
+public sealed class CancellationPolicy(CancellationPolicyOptions options)
+{
+    /// <summary>The consequence of cancelling <paramref name="appointment"/> at <paramref name="at"/>.</summary>
+    public CancellationDecision EvaluateCancellation(Appointment appointment, CancellationReason reason, DateTimeOffset at)
+    {
+        ArgumentNullException.ThrowIfNull(appointment);
+
+        if (reason == CancellationReason.PractitionerUnavailable)
+        {
+            return CancellationDecision.Free("clinic-initiated");
+        }
+
+        if (at <= appointment.Time.Start - options.FreeCancellationWindow)
+        {
+            return CancellationDecision.Free("free");
+        }
+
+        return new CancellationDecision(options.LateCancellationFee, true, "late");
+    }
+}
diff --git a/src/ClinicScheduling.Domain/Policies/CancellationPolicyOptions.cs b/src/ClinicScheduling.Domain/Policies/CancellationPolicyOptions.cs
new file mode 100644
index 0000000..f0a72cf
--- /dev/null
+++ b/src/ClinicScheduling.Domain/Policies/CancellationPolicyOptions.cs
@@ -0,0 +1,9 @@
+namespace ClinicScheduling.Domain.Policies;
+
+public sealed record CancellationPolicyOptions
+{
+    /// <summary>A patient may cancel free of charge up to this long before the appointment starts.</summary>
+    public TimeSpan FreeCancellationWindow { get; init; } = TimeSpan.FromHours(24);
+
+    public decimal LateCancellationFee { get; init; } = 250m;
+}
