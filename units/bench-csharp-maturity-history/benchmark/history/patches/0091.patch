From: Noor Haddley <noor.haddley@example.invalid>
Date: Mon, 13 Jul 2026 11:25:59 +0200
Subject: fix(availability): leave the room turnaround free before closing

---
 src/ClinicScheduling.Domain/Availability/SlotFinder.cs        | 3 ++-
 src/ClinicScheduling.Domain/Availability/SlotSearchOptions.cs | 3 +++
 .../Availability/SlotFinderTests.cs                           | 4 ++--
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/ClinicScheduling.Domain/Availability/SlotFinder.cs b/src/ClinicScheduling.Domain/Availability/SlotFinder.cs
index 2ce0d61..5bcef95 100644
--- a/src/ClinicScheduling.Domain/Availability/SlotFinder.cs
+++ b/src/ClinicScheduling.Domain/Availability/SlotFinder.cs
@@ -60,9 +60,10 @@ public sealed class SlotFinder(IHolidayCalendar holidays, TimeProvider time)
             {
                 var opens = At(day, hours.Opens, schedule.TimeZone);
                 var closes = At(day, hours.Closes, schedule.TimeZone);
+                var lastEnd = closes - options.RoomTurnaround;
                 var cursor = opens;
 
-                while (cursor + query.Duration <= closes)
+                while (cursor + query.Duration <= lastEnd)
                 {
                     var candidate = new TimeRange(cursor, cursor + query.Duration);
 
diff --git a/src/ClinicScheduling.Domain/Availability/SlotSearchOptions.cs b/src/ClinicScheduling.Domain/Availability/SlotSearchOptions.cs
index 6998259..e0d99ed 100644
--- a/src/ClinicScheduling.Domain/Availability/SlotSearchOptions.cs
+++ b/src/ClinicScheduling.Domain/Availability/SlotSearchOptions.cs
@@ -8,6 +8,9 @@ public sealed record SlotSearchOptions
     /// <summary>Kept free before and after every booked appointment.</summary>
     public TimeSpan BufferBetweenAppointments { get; init; } = TimeSpan.FromMinutes(5);
 
+    /// <summary>Time to turn a treatment room around; an in-clinic visit must leave it before closing.</summary>
+    public TimeSpan RoomTurnaround { get; init; } = TimeSpan.FromMinutes(10);
+
     /// <summary>The earliest a slot may start, measured from now.</summary>
     public TimeSpan MinimumNotice { get; init; } = TimeSpan.FromHours(2);
 
diff --git a/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs b/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
index 296fdcd..c88ef37 100644
--- a/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
+++ b/tests/ClinicScheduling.UnitTests/Availability/SlotFinderTests.cs
@@ -15,13 +15,13 @@ public sealed class SlotFinderTests
         new(Monday.AddDays(1), Monday.AddDays(1), duration ?? HalfHour, skill, telehealth);
 
     [Fact]
-    public void OffersSlotsOnTheGranularity()
+    public void OffersSlotsOnTheGranularityUntilRoomTurnaround()
     {
         var slots = Finder().FindOpenSlots(Schedule(), [], Tuesday(), new SlotSearchOptions());
 
         Assert.Equal(At(Monday.AddDays(1), 8), slots[0].Start);
         Assert.Equal(At(Monday.AddDays(1), 8, 15), slots[1].Start);
-        Assert.Equal(At(Monday.AddDays(1), 16), slots[^1].End);
+        Assert.Equal(At(Monday.AddDays(1), 15, 45), slots[^1].End);
     }
 
     [Fact]
