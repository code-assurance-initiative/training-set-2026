diff --git a/src/ClinicScheduling.Api/Hosting/ApiApplicationBuilderExtensions.cs b/src/ClinicScheduling.Api/Hosting/ApiApplicationBuilderExtensions.cs
new file mode 100644
index 0000000..3746fad
--- /dev/null
+++ b/src/ClinicScheduling.Api/Hosting/ApiApplicationBuilderExtensions.cs
@@ -0,0 +1,22 @@
+using ClinicScheduling.Api.Security;
+
+namespace ClinicScheduling.Api.Hosting;
+
+public static class ApiApplicationBuilderExtensions
+{
+    public static WebApplication UseSchedulingApi(this WebApplication app)
+    {
+        if (!app.Environment.IsDevelopment())
+        {
+            app.UseHsts();
+        }
+
+        app.UseExceptionHandler();
+        app.UseStatusCodePages();
+        app.UseHttpsRedirection();
+        app.UseMiddleware<SecurityHeadersMiddleware>();
+
+        app.MapHealthChecks("/health").AllowAnonymous();
+        return app;
+    }
+}
diff --git a/src/ClinicScheduling.Api/Hosting/ApiServiceCollectionExtensions.cs b/src/ClinicScheduling.Api/Hosting/ApiServiceCollectionExtensions.cs
new file mode 100644
index 0000000..fb78851
--- /dev/null
+++ b/src/ClinicScheduling.Api/Hosting/ApiServiceCollectionExtensions.cs
@@ -0,0 +1,12 @@
+namespace ClinicScheduling.Api.Hosting;
+
+public static class ApiServiceCollectionExtensions
+{
+    public static IServiceCollection AddSchedulingApi(this IServiceCollection services)
+    {
+        services.AddProblemDetails();
+        services.AddHealthChecks();
+        services.AddHsts(options => options.MaxAge = TimeSpan.FromDays(365));
+        return services;
+    }
+}
diff --git a/src/ClinicScheduling.Api/Program.cs b/src/ClinicScheduling.Api/Program.cs
