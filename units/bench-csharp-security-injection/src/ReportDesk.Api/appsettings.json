{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "reportdesk-api"
  },
  "ConnectionStrings": {
    "Archive": "Host=archive-db;Database=archive;Username=reportdesk;SSL Mode=Require"
  },
  "Storage": {
    "AttachmentsRoot": "/var/lib/reportdesk/attachments",
    "TemplatesRoot": "/var/lib/reportdesk/templates",
    "ScratchRoot": "/var/lib/reportdesk/scratch"
  },
  "Conversion": {
    "SofficePath": "/usr/bin/soffice",
    "ConvertPath": "/usr/bin/convert",
    "Timeout": "00:01:00"
  },
  "Feeds": {
    "AllowedHosts": [ "records.partner-one.example", "feeds.partner-two.example" ]
  },
  "Directory": {
    "Server": "ldap.archive.internal",
    "Port": 636,
    "BaseDn": "ou=people,dc=archive,dc=internal",
    "GroupsDn": "ou=groups,dc=archive,dc=internal"
  },
  "Delivery": {
    "CrmBaseAddress": "https://crm.archive.internal/api/",
    "SenderAddress": "reports@archive.internal"
  }
}
