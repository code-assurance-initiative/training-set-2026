[*.cs]
# Production code never resumes on a captured context.
dotnet_diagnostic.CA2007.severity = warning

# The messaging contracts follow the vocabulary of the message-bus libraries they abstract
# (IIntegrationEventHandler<T>), which CA1711 reserves for delegate types.
dotnet_diagnostic.CA1711.severity = none

# EF Core migrations are generated by `dotnet ef migrations add`; they are not edited by hand.
[**/Migrations/*.cs]
generated_code = true
