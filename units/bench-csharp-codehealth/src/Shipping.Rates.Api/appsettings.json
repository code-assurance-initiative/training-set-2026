{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "shipping-rates-api"
  },
  "Carriers": {
    "Alder": {
      "BaseAddress": "https://api.alder-parcel.invalid/"
    },
    "Corvid": {
      "BaseAddress": "https://api.corvid-courier.invalid/"
    }
  },
  "Shipping": {
    "DailyCutoff": "16:00"
  },
  "Labels": {
    "StorageRoot": "labels",
    "LabelPrefix": "SR",
    "Currency": "EUR"
  }
}
