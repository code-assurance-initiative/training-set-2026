diff --git a/contracts/asyncapi.yaml b/contracts/asyncapi.yaml
new file mode 100644
index 0000000..782cc47
--- /dev/null
+++ b/contracts/asyncapi.yaml
@@ -0,0 +1,31 @@
+asyncapi: 3.0.0
+info:
+  title: Quellbrook notifier — consumed events
+  version: 1.0.0
+  description: The notifier publishes no events; it consumes these from the platform's RabbitMQ topic exchange.
+servers:
+  production:
+    host: rabbitmq.messaging.svc.cluster.local:5671
+    protocol: amqps
+    pathname: /quellbrook
+channels:
+  notifierEvents:
+    address: notifier.events
+    description: >-
+      Durable queue bound to orders.order-placed.v1, dispatch.consignment-out-for-delivery.v1 and
+      dispatch.consignment-delivered.v1; dead-letters to quellbrook.dead-letter.
+    messages:
+      orderPlaced:
+        payload:
+          $ref: './consumed/orders/order-placed.v1.schema.json'
+      consignmentOutForDelivery:
+        payload:
+          $ref: './consumed/dispatch/consignment-out-for-delivery.v1.schema.json'
+      consignmentDelivered:
+        payload:
+          $ref: './consumed/dispatch/consignment-delivered.v1.schema.json'
+operations:
+  consumeEvents:
+    action: receive
+    channel:
+      $ref: '#/channels/notifierEvents'
diff --git a/contracts/consumed/README.md b/contracts/consumed/README.md
new file mode 100644
index 0000000..a5769e7
--- /dev/null
+++ b/contracts/consumed/README.md
@@ -0,0 +1,12 @@
+# Consumed event schemas
+
+Pinned copies of the producers' schemas that the notifier implements (`src/Quellbrook.Notifier/Messaging/Messages.cs`):
+
+| Schema | Producer | Version pinned | Fields the notifier reads |
+|---|---|---|---|
+| `orders/order-placed.v1.schema.json` | estate-quellbrook-orders | v0.3.0 | order id, consignee name, contact e-mail and phone |
+| `dispatch/consignment-out-for-delivery.v1.schema.json` | estate-quellbrook-dispatch | v0.3.0 | order id |
+| `dispatch/consignment-delivered.v1.schema.json` | estate-quellbrook-dispatch | v0.3.0 | order id, delivery time |
+
+Within v1 the producers only add optional fields; the notifier ignores fields it does not read. Update a copy when its
+producer announces a new version.
diff --git a/contracts/consumed/dispatch/consignment-delivered.v1.schema.json b/contracts/consumed/dispatch/consignment-delivered.v1.schema.json
new file mode 100644
index 0000000..ee7ea07
--- /dev/null
+++ b/contracts/consumed/dispatch/consignment-delivered.v1.schema.json
@@ -0,0 +1,14 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://quellbrook.example/contracts/dispatch/consignment-delivered.v1.schema.json",
+  "title": "dispatch.consignment-delivered.v1",
+  "description": "Published by the dispatch service when a driver records a delivery. Owned by the Fleet team. Within v1 fields are only added.",
+  "type": "object",
+  "required": ["consignmentId", "orderId", "proof", "deliveredAt"],
+  "properties": {
+    "consignmentId": { "type": "string", "format": "uuid" },
+    "orderId": { "type": "string", "format": "uuid" },
+    "proof": { "enum": ["signature", "photo", "safe-place"] },
+    "deliveredAt": { "type": "string", "format": "date-time" }
+  }
+}
