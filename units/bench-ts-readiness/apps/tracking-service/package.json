{
  "name": "@parcel-tracking/tracking-service",
  "version": "0.0.0",
  "description": "Parcel tracking API and carrier-polling worker.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "migrate": "node dist/db/migrate.js",
    "test:bdd": "TSX_TSCONFIG_PATH=../../tsconfig.json NODE_OPTIONS='--import tsx' cucumber-js",
    "test:bdd:webhooks": "TSX_TSCONFIG_PATH=../../tsconfig.json NODE_OPTIONS='--import tsx' cucumber-js --profile webhooks"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@parcel-tracking/webhooks": "0.4.1"
  }
}
