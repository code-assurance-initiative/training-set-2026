+openapi: 3.1.0
+info:
+  title: Quellbrook Orders API
+  version: 0.1.0
+  description: Order service of the Quellbrook operations platform. Called by the API gateway only.
+servers:
+  - url: http://quellbrook-orders.quellbrook-orders.svc.cluster.local
+security:
+  - bearer: []
+paths:
+  /orders:
+    post:
+      summary: Place an order
+      security:
+        - bearer: [orders:write]
+      parameters:
+        - $ref: '#/components/parameters/Operator'
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/PlaceOrderRequest'
+      responses:
+        '201':
+          description: Placed; Location names the order.
+        '400':
+          $ref: '#/components/responses/Problem'
+        '422':
+          $ref: '#/components/responses/Problem'
+    get:
+      summary: List orders, newest first
+      security:
+        - bearer: [orders:read]
+      parameters:
+        - name: page
+          in: query
+          schema: { type: integer, minimum: 1, default: 1 }
+        - name: pageSize
+          in: query
+          schema: { type: integer, minimum: 1, maximum: 100, default: 25 }
+      responses:
+        '200':
+          description: One page of orders.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/OrderPage'
+  /orders/{id}:
+    get:
+      summary: Read one order
+      security:
+        - bearer: [orders:read]
+      parameters:
+        - name: id
+          in: path
+          required: true
+          schema: { type: string, format: uuid }
+      responses:
+        '200':
+          description: The order.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Order'
+        '404':
+          description: No such order.
+components:
+  securitySchemes:
+    bearer:
+      type: http
+      scheme: bearer
+      bearerFormat: JWT
+  parameters:
+    Operator:
+      name: X-Quellbrook-Operator
+      in: header
+      required: true
+      description: The id of the operator acting, as authenticated by the gateway.
+      schema: { type: string, minLength: 1, maxLength: 64 }
+  responses:
+    Problem:
+      description: RFC 9457 problem details.
+      content:
+        application/problem+json:
+          schema: { type: object }
+  schemas:
+    PlaceOrderRequest:
+      type: object
+      required: [customerAccountId, serviceLevel, consignee, parcels]
+      properties:
+        customerAccountId: { type: string, pattern: '^QB-[0-9]{4,12}$' }
+        serviceLevel: { type: string, enum: [standard, express] }
+        consignee: { $ref: '#/components/schemas/Consignee' }
+        parcels:
+          type: array
+          minItems: 1
+          maxItems: 20
+          items: { $ref: '#/components/schemas/ParcelRequest' }
+    Consignee:
+      type: object
+      required: [name, line1, postalCode, city, countryCode]
+      properties:
+        name: { type: string, maxLength: 100 }
+        line1: { type: string, maxLength: 100 }
+        line2: { type: [string, 'null'], maxLength: 100 }
+        postalCode: { type: string, maxLength: 10 }
+        city: { type: string, maxLength: 60 }
+        countryCode: { type: string, enum: [DK, SE, NO, DE, NL] }
+        email: { type: [string, 'null'], maxLength: 254 }
+        phone: { type: [string, 'null'], maxLength: 20 }
+    ParcelRequest:
+      type: object
+      required: [weightGrams, lengthCm, widthCm, heightCm]
+      properties:
+        weightGrams: { type: integer, minimum: 1, maximum: 31500 }
+        lengthCm: { type: integer, minimum: 1, maximum: 175 }
+        widthCm: { type: integer, minimum: 1, maximum: 175 }
+        heightCm: { type: integer, minimum: 1, maximum: 175 }
+    Order:
+      type: object
+      properties:
+        id: { type: string, format: uuid }
+        customerAccountId: { type: string }
+        serviceLevel: { type: string }
+        status: { type: string, enum: [placed, cancelled] }
+        consignee: { $ref: '#/components/schemas/Consignee' }
+        parcels:
+          type: array
+          items:
+            type: object
+            properties:
+              number: { type: integer }
+              weightGrams: { type: integer }
+              lengthCm: { type: integer }
+              widthCm: { type: integer }
+              heightCm: { type: integer }
+        totalWeightGrams: { type: integer }
+        placedBy: { type: string }
+        placedAt: { type: string, format: date-time }
+    OrderPage:
+      type: object
+      properties:
+        items:
+          type: array
+          items:
+            type: object
+            properties:
+              orderId: { type: string, format: uuid }
+              customerAccountId: { type: string }
+              serviceLevel: { type: string }
+              status: { type: string }
+              consigneeName: { type: string }
+              destinationCity: { type: string }
+              parcelCount: { type: integer }
+              placedAt: { type: string, format: date-time }
+        page: { type: integer }
+        pageSize: { type: integer }
+        totalCount: { type: integer }
