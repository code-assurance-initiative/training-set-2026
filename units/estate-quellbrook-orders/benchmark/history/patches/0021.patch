diff --git a/contracts/asyncapi.yaml b/contracts/asyncapi.yaml
new file mode 100644
index 0000000..e0aecc5
--- /dev/null
+++ b/contracts/asyncapi.yaml
@@ -0,0 +1,42 @@
+asyncapi: 3.0.0
+info:
+  title: Quellbrook order events
+  version: 1.0.0
+  description: Events published by the order service on the platform's RabbitMQ topic exchange.
+servers:
+  production:
+    host: rabbitmq.messaging.svc.cluster.local:5671
+    protocol: amqps
+    pathname: /quellbrook
+channels:
+  orderPlaced:
+    address: orders.order-placed.v1
+    messages:
+      orderPlaced:
+        $ref: '#/components/messages/orderPlaced'
+  orderCancelled:
+    address: orders.order-cancelled.v1
+    messages:
+      orderCancelled:
+        $ref: '#/components/messages/orderCancelled'
+operations:
+  publishOrderPlaced:
+    action: send
+    channel:
+      $ref: '#/channels/orderPlaced'
+  publishOrderCancelled:
+    action: send
+    channel:
+      $ref: '#/channels/orderCancelled'
+components:
+  messages:
+    orderPlaced:
+      contentType: application/json
+      correlationId:
+        location: $message.header#/message_id
+      payload:
+        $ref: './events/order-placed.v1.schema.json'
+    orderCancelled:
+      contentType: application/json
+      payload:
+        $ref: './events/order-cancelled.v1.schema.json'
diff --git a/contracts/events/order-cancelled.v1.schema.json b/contracts/events/order-cancelled.v1.schema.json
new file mode 100644
index 0000000..4348cf1
--- /dev/null
+++ b/contracts/events/order-cancelled.v1.schema.json
@@ -0,0 +1,13 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://quellbrook.example/contracts/orders/order-cancelled.v1.schema.json",
+  "title": "orders.order-cancelled.v1",
+  "description": "Published by the order service when an order is cancelled. Owned by the Orders team.",
+  "type": "object",
+  "required": ["orderId", "reason", "cancelledAt"],
+  "properties": {
+    "orderId": { "type": "string", "format": "uuid" },
+    "reason": { "type": "string", "maxLength": 200 },
+    "cancelledAt": { "type": "string", "format": "date-time" }
+  }
+}
diff --git a/contracts/events/order-placed.v1.schema.json b/contracts/events/order-placed.v1.schema.json
new file mode 100644
index 0000000..54e1117
--- /dev/null
+++ b/contracts/events/order-placed.v1.schema.json
@@ -0,0 +1,56 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://quellbrook.example/contracts/orders/order-placed.v1.schema.json",
+  "title": "orders.order-placed.v1",
+  "description": "Published by the order service when an order is placed. Owned by the Orders team. Within v1 fields are only added, never renamed or removed; consumers ignore fields they do not know.",
+  "type": "object",
+  "required": ["orderId", "customerAccountId", "serviceLevel", "consignee", "parcels", "placedAt"],
+  "properties": {
+    "orderId": { "type": "string", "format": "uuid" },
+    "customerAccountId": { "type": "string", "pattern": "^QB-[0-9]{4,12}$" },
+    "serviceLevel": { "enum": ["standard", "express"] },
+    "consignee": {
+      "type": "object",
+      "required": ["name", "address", "contact"],
+      "properties": {
+        "name": { "type": "string", "maxLength": 100 },
+        "address": {
+          "type": "object",
+          "required": ["line1", "postalCode", "city", "countryCode"],
+          "properties": {
+            "line1": { "type": "string", "maxLength": 100 },
+            "line2": { "type": ["string", "null"], "maxLength": 100 },
+            "postalCode": { "type": "string", "maxLength": 10 },
+            "city": { "type": "string", "maxLength": 60 },
+            "countryCode": { "enum": ["DK", "SE", "NO", "DE", "NL"] }
+          }
+        },
+        "contact": {
+          "type": "object",
+          "description": "Personal data: used only to notify the consignee about this delivery (docs/privacy.md).",
+          "properties": {
+            "email": { "type": ["string", "null"], "format": "email" },
+            "phone": { "type": ["string", "null"], "pattern": "^\\+[1-9][0-9]{7,14}$" }
+          }
+        }
+      }
+    },
+    "parcels": {
+      "type": "array",
+      "minItems": 1,
+      "maxItems": 20,
+      "items": {
+        "type": "object",
+        "required": ["number", "weightGrams", "lengthCm", "widthCm", "heightCm"],
+        "properties": {
+          "number": { "type": "integer", "minimum": 1 },
+          "weightGrams": { "type": "integer", "minimum": 1, "maximum": 31500 },
+          "lengthCm": { "type": "integer", "minimum": 1, "maximum": 175 },
+          "widthCm": { "type": "integer", "minimum": 1, "maximum": 175 },
+          "heightCm": { "type": "integer", "minimum": 1, "maximum": 175 }
+        }
+      }
+    },
+    "placedAt": { "type": "string", "format": "date-time" }
+  }
+}
