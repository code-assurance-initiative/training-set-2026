{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Polling": {
    "Interval": "00:02:00",
    "PollAge": "00:15:00",
    "BatchSize": 200,
    "NotificationInterval": "00:00:30",
    "HeartbeatPath": "/tmp/heartbeat"
  },
  "Retention": {
    "DeliveredNotifications": "30.00:00:00",
    "CompletedParcels": "180.00:00:00",
    "SweepInterval": "06:00:00"
  },
  "CarrierApi": {
    "BaseAddress": "https://api.carrier-hub.internal/",
    "AttemptTimeout": "00:00:05",
    "TotalTimeout": "00:00:30",
    "MaxRetryAttempts": 3
  },
  "MerchantWebhooks": {
    "BaseAddress": "https://merchant-hooks.internal/"
  }
}
